# Backend Configuration
PORT=5000
NODE_ENV=production
DATABASE_URL=sqlite:./webshield.db

# VirusTotal API (Free tier available)
VIRUSTOTAL_API_KEY=db21372d495a0472a7ecbed1752df29c6e218b6665b9c752903f705a5f059ae8

# OpenAI for AI Analysis
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo

# ClamAV (Self-hosted antivirus)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# IP Geolocation & Threat Intelligence
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# SendGrid for Email Alerts
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=alerts@webshield.local

# Stripe for Payments
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# JWT Secret for Auth
JWT_SECRET=your_jwt_secret_key_here
